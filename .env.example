# Copy to .env if you want to change defaults. Never commit .env.
# Default: fully local and free (Ollama). Pull the models first:
#   ollama pull qwen2.5:7b-instruct && ollama pull nomic-embed-text
JARVIS_LLM_PROVIDER=ollama             # ollama (free, local) | anthropic (paid API)
JARVIS_OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional, paid: Claude API
# JARVIS_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# JARVIS_ANTHROPIC_MODEL=claude-opus-5-5
# JARVIS_ANTHROPIC_EFFORT=medium

# Leave empty for in-memory chat memory; set to use Postgres (docker compose up -d):
JARVIS_DATABASE_URL=
# JARVIS_DATABASE_URL=postgresql://jarvis:jarvis@localhost:5433/jarvis
